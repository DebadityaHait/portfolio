{
  "zone": "dhait.de",
  "phase": "http_request_dynamic_redirect",
  "rules": [
    {
      "ref": "portfolio_canonical_domain",
      "description": "Portfolio: HTTPS and canonical apex domain",
      "expression": "(http.host eq \"www.dhait.de\") or (http.host eq \"dhait.de\" and not ssl)",
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "status_code": 308,
          "target_url": { "expression": "concat(\"https://dhait.de\", http.request.uri.path)" },
          "preserve_query_string": true
        }
      },
      "enabled": true
    }
  ]
}
