{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "debaditya-portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "dhait.de", "custom_domain": true },
    { "pattern": "www.dhait.de", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "LASTFM_USERNAME": "zvrz"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-dino",
      "database_id": "e17c0b50-85cc-4ec3-88a4-a3198889ea10",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "SCORE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  },
  "account_id": "aacc314c5dec61bc4421c85f7ec836a3"
}
